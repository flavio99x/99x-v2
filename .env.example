# Contact form delivery (src/lib/contact/provider.ts). Without RESEND_API_KEY submissions are only logged.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Comma-separated recipients.
CONTACT_TO=hello.norway@99x.io
# Must be on a domain verified in Resend. Resend's test sender (onboarding@resend.dev) only delivers to the Resend account owner's address.
CONTACT_FROM=99x website <website@99x.io>
# Optional override: "log" or "resend".
# CONTACT_PROVIDER=log
# Search indexing (src/lib/indexable.ts): only a production deploy with this set to "true" is indexable. Set it at launch on 99x.io.
# SITE_INDEXABLE=true
